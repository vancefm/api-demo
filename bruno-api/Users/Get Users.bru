meta {
  name: Get Users
  type: http
  seq: 1
}

get {
  url: http://localhost:8080/api/v1/users?page=0&size=20&sort=id,asc
  body: none
  auth: inherit
}

params:query {
  page: 0
  size: 20
  sort: id,asc
}

docs {
  Results are scoped to the departments the caller may read and masked to the
  fields the caller may read. Switch the request auth to user1/password1 to see
  the difference once user1 has been granted a role.
}

settings {
  encodeUrl: true
  timeout: 0
}

meta {
  name: Create Department User Role
  type: http
  seq: 2
}

post {
  url: http://localhost:8080/api/v1/roles
  body: json
  auth: inherit
}

body:json {
  {
    "name": "Department User",
    "description": "Reads users in its department and edits their names",
    "permissions": [
      { "entity": "User", "field": "username",  "operation": "READ" },
      { "entity": "User", "field": "email",     "operation": "READ" },
      { "entity": "User", "field": "firstName", "operation": "READ" },
      { "entity": "User", "field": "lastName",  "operation": "READ" },
      { "entity": "User", "field": "firstName", "operation": "UPDATE" },
      { "entity": "User", "field": "lastName",  "operation": "UPDATE" }
    ]
  }
}

vars:post-response {
  roleId: res.body.id
}

settings {
  encodeUrl: true
  timeout: 0
}
